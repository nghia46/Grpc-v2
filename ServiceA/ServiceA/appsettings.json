{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://*:8081"
      },
      "Grpc": {
        "Url": "http://*:5006",
        "Protocols": "Http2"
      }
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ServiceB": {
    //"BaseUrl": "http://service-b-lb:5005" // For Kubernetes
    "BaseUrl": "http://localhost:5005" // For local
    // "BaseUrl": "http://service-b:5005" // For Docker-Compose
  }
}
